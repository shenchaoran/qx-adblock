    {"match": "ma-adx.ctrip.com",                                           "note": "广告埋点"},

    {"match": "118.89.204.198",                                           "note": "拦截对广告服务器 IP 的直连访问"},
    {"match": "103.41.167.237",                                           "note": "拦截对广告服务器 IP 的直连访问"},
    {"match": "2402:4e00:1200:ed00:0:9089:6dac:96b6",                     "note": "拦截对广告服务器 IPv6 的直连访问"},
    {"match": "commercial_api.*launch_v2",                                "note": "开屏广告"},
    {"match": ".*zhihu.com/commercial_api",                               "note": "商业化接口整体拦截（广告、浮层、开屏等）"},
    {"match": "brand/question",                                           "note": "品牌提问广告"},
    {"match": "ad-style-service/request",                                 "note": "广告样式服务"},
    {"match": "api.zhihu.com/next-render",                                "note": "回答页翻页去广告"},

    {"match": "app.bilibili.com/x/v2/splash/show",                          "note": "开屏广告"},
    {"match": "app.bilibili.com/x/v2/splash/list",                          "note": "开屏广告列表"},
    {"match": "app.bilibili.com/x/v2/feed/index",                           "note": "首页推荐流去广告"},
    {"match": "app.bilibili.com/x/resource/show/tab",                       "note": "顶栏 / 底栏标签精简"},
    {"match": "app.bilibili.com/x/resource/top/activity",                   "note": "顶部活动入口"},
    {"match": "app.bilibili.com/x/v2/search/square",                        "note": "搜索页热搜与推广"},

    {"match": "system_service/splash_config",                               "note": "开屏广告预加载（把投放时间改到远期）"},
    {"match": "system_service/splash",                                      "note": "开屏广告"},
    {"match": "system_service/config",                                      "note": "启动配置（去掉商城入口、开屏图、加载图）"},
    {"match": "search/notes/recommend_info",                                "note": "搜索结果推荐信息"},
    {"match": "search/notes?",                                              "note": "搜索结果去广告"},
    {"match": "note/widgets",                                               "note": "笔记详情页挂件（商品卡、活动卡）"},
    {"match": "homefeed/categories",                                        "note": "首页频道（去掉购物、直播等商业频道）"},
    {"match": "/homefeed?",                                                 "note": "首页信息流去广告"},
    {"match": "/api/gslb",                                                  "note": "HTTPDNS 调度（让广告域名解析失败）"},
    {"match": "/api/httpdns",                                               "note": "HTTPDNS 调度（让广告域名解析失败）"},
    {"match": "(tag/)?ads",                                                 "note": "广告接口"},
    {"match": "stateReport",                                                "note": "状态上报"},
    {"match": "matrix_switches",                                            "note": "运营开关"},
    {"match": "teenager/status",                                            "note": "青少年模式状态上报"},
    {"match": "guide/home_guide",                                           "note": "首页引导弹窗"}
  ],

